# Copy to backend/.env. Never commit .env.
# Leave both keys empty to run on the mock LLM.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# Check the current model name in the OpenAI dashboard before relying on this default.
OPENAI_MODEL=gpt-4.1-mini
MAX_TOKENS=1024
MOCK_LLM=0
DATABASE_URL=sqlite:///./app.db
FRONTEND_ORIGINS=http://localhost:3000
# Vercel preview URLs change per deploy; allow them with a regex:
FRONTEND_ORIGIN_REGEX=
