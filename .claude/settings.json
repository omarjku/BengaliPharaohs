{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(./scripts/e2e.sh)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(npm run:*)",
      "Bash(npx tsc:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Bash(cat:*.env*)"
    ]
  }
}
