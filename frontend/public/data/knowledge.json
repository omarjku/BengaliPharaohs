    "q_whole_field_old_leaves": {"en": "Is the whole field evenly pale, starting from the old bottom leaves?", "bn": "(Zoha)"},
    "q_tip_edge_after_storm": {"en": "Did the yellowing start at the leaf tip and edge, after a storm or flood?", "bn": "(Zoha)"},
    "q_thin_streaks_translucent": {"en": "Are the lines thin, between the veins, and see-through against the sun?", "bn": "(Zoha)"},
    "q_zonate_bands": {"en": "Do you see bands of light and dark brown in the dried part?", "bn": "(Zoha)"},
    "q_khaira_after_transplant": {"en": "Did brown dusty patches appear 2-4 weeks after transplanting, on young leaves?", "bn": "(Zoha)"},
    "q_tap_base_hoppers": {"en": "Tap the plant base: do many small brown insects jump onto the water?", "bn": "(Zoha)"},
    "q_deadheart_pulls_out": {"en": "Does the dead centre shoot or white panicle pull out easily?", "bn": "(Zoha)"},
    "q_cold_spell": {"en": "Were there several very cold nights just before this?", "bn": "(Zoha)"},
    "q_salty_water": {"en": "Did salty or tidal water enter the field?", "bn": "(Zoha)"},
