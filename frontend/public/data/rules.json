        "seedbed_deadline_md": "08-30",
        "deadline_md": "09-15",
        "varieties_late": [
          "BR22",
          "BR23",
          "BRRI dhan34",
          "BRRI dhan46",
          "BRRI dhan54",
          "Nizersail (local)"
        ],
        "varieties_short": [
          "BRRI dhan57",
          "BRRI dhan62"
        ],
        "seedlings_per_hill": [
          4,
          5
        ],
        "spacing_cm": [
          20,
          15
        ],
        "seedling_sources": [
          "SAAO",
          "upazila agriculture office",
          "BADC",
          "unflooded neighbour"
        ],
        "alternatives": [
          "DIRECT_SEED"
        ]
      },
      "sources": [
        "S_MOA",
        "S_GAIN",
        "S_BRJ_PS"
      ],
      "status": "VERIFIED"
    },
    {
      "id": "D10",
      "when": {
        "outlook": {
          "eq": "likely_lost"
        },
        "md": {
          "between": [
            "09-01",
            "09-15"
          ]
        }
      },
      "output": "REPLANT_SHORT_DURATION",
      "params": {
        "deadline_md": "09-15",
        "own_seedbed": false,
        "varieties_late": [
          "BR22",
          "BR23",
          "BRRI dhan46",
          "BRRI dhan54"
        ],
        "seedling_age_days": [
          30,
          45
        ],
        "seedlings_per_hill": [
          4,
          5
        ],
        "spacing_cm": [
          20,
          15
        ],
        "seedling_sources": [
          "SAAO",
