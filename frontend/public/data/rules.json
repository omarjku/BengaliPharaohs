          ]
        },
        "region": {
          "ne": "barind"
        },
        "north": {
          "ne": true
        }
      },
      "output": "NOT_SURE_ASK_SAAO",
      "params": {
        "reason": "cutoff_grey_zone"
      },
      "sources": [
        "S_MOA",
        "S_GAIN"
      ],
      "status": "NEEDS-CHECK"
    },
    {
      "id": "D12",
      "when": {
        "outlook": {
          "eq": "likely_lost"
        },
        "md": {
          "gte": "09-16"
        }
      },
      "output": "TOO_LATE_AMAN",
      "params": {
        "cutoff_md": "09-15",
        "cutoff_md_centre_south": "09-20",
